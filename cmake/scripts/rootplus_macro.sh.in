#!/bin/bash
# This file is based on FairRoot's cmake/scripts/root_macro.sh.in
#
# It is used to start ROOT macros from CMake tests with the environment
# required by c4Root/FairRoot.

# ------------------------------------------------------------------------------
# Runtime environment
# ------------------------------------------------------------------------------

export LD_LIBRARY_PATH="@MY_LD_LIBRARY_PATH@":$LD_LIBRARY_PATH
export PATH="@MY_PATH@":$PATH

export ROOTSYS="@ROOTSYS@"
export ROOTEXE="@ROOTSYS@/bin/root"

export ROOT_INCLUDE_PATH="@ROOT_INCLUDE_PATH@"

export FAIRROOTPATH="@FAIRROOTPATH@"
export VMCWORKDIR="@VMCWORKDIR@"

# ------------------------------------------------------------------------------
# Convert command-line arguments into a comma-separated ROOT argument list
# ------------------------------------------------------------------------------

parameters=""

for i in "$@"; do

    if [ -z "$parameters" ]; then
        parameters="$i"
    else
        parameters="$parameters,$i"
    fi

done


# ------------------------------------------------------------------------------
# Run the requested ROOT macro
# ------------------------------------------------------------------------------

cd "@new_path@" || exit 1

# Add c4Root headers to ROOT's include search path.
ROOT_INCLUDE_PATH="$ROOT_INCLUDE_PATH:$(find "$VMCWORKDIR" -iname '*.h' \
    -exec dirname {} \; | sort -u | tr '\n' ':' | sed 's/:$//')"

export ROOT_INCLUDE_PATH

"$ROOTEXE" -q -b "@my_script_name@"+g\($parameters\)